{
  "name": "imperio-corporativo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Simulador de Império Corporativo — jogo de gerenciamento empresarial",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "fflate": "^0.8.3",
    "pixi.js": "^8.19.0",
    "seedrandom": "^3.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/seedrandom": "^3.0.8",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
